# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# contains plaintext developer credentials — never commit
/docs/DEVELOPER.md

# hosting CLIs
.vercel
.netlify
.fly

# local embedded dev database (see scripts/dev-db.mjs)
/.vault-data/

# typescript
*.tsbuildinfo
next-env.d.ts

# AI coding-assistant instructions (next dev regenerates AGENTS.md)
AGENTS.md
CLAUDE.md
