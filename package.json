{
  "name": "vault",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/dev-db.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup": "node scripts/setup.mjs",
    "check-env": "node scripts/setup.mjs --check",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "build:deploy": "prisma migrate deploy && next build",
    "vercel-build": "npm run build:deploy",
    "db:seed": "tsx prisma/seed.ts",
    "create-user": "tsx scripts/create-user.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "delete-user": "tsx scripts/delete-user.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-pdf/renderer": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "fflate": "^0.8.3",
    "jose": "^6.2.3",
    "lucide-react": "^1.23.0",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yahoo-finance2": "^3.15.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  }
}
