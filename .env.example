# DATABASE SETTINGS
# Prisma PostgreSQL connection string.
# For local development, `npm run dev` auto-starts a zero-config embedded
# Postgres (see scripts/dev-db.mjs) and this default already matches it.
# In production, point this at a managed Postgres instance
# (Vercel Postgres, Neon, Supabase, etc.).
DATABASE_URL="postgresql://vault:vault@127.0.0.1:5432/vault_db?schema=public"
# In production, point DATABASE_URL at a POOLED endpoint (PgBouncer / Neon /
# Supabase pooler) and keep the app-side pool small:
# DATABASE_POOL_MAX="5"
# Optional: a DIRECT (non-pooled) connection string used only for migrations.
# Set it if `prisma migrate deploy` fails through the pooler (e.g. Neon's
# connection string without "-pooler" in the host name).
# DIRECT_URL=""

# AUTH SETTINGS
# Random string used to sign JWT session cookies. REQUIRED — the app refuses to
# start without it. Must be at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=""

# DEVELOPER ACCESS CREDENTIALS
# Optional. When BOTH are set, this email/password can sign in through the normal
# login form as the DEVELOPER account. Leave either blank to disable that path.
# There is no hardcoded fallback. Use a unique, strong password.
DEV_USERNAME="developer@vault.io"
DEV_PASSWORD=""

# CRON
# Bearer token required by /api/cron/* routes (Vercel Cron sends this automatically
# when configured as the `Authorization` header in vercel.json). Generate with:
#   openssl rand -hex 32
CRON_SECRET=""

# PUBLIC URL of this install (links in reminder emails). https:// in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# CLIENT IP FOR RATE LIMITING
# Which proxy header to trust for the caller's IP. Headers are only trusted
# when a proxy you control sets them; otherwise anyone can forge them.
#   vercel      on Vercel (detected automatically)
#   netlify     on Netlify (detected automatically when NETLIFY=true)
#   cloudflare  origin reachable ONLY through Cloudflare (cf-connecting-ip)
#   1, 2, …     that many reverse proxies (nginx/Caddy/load balancer) in front;
#               Render, Railway and Fly.io use 1
#   none        directly exposed (default): all callers share one bucket
TRUST_PROXY="none"

# Set to "false" to close self-service sign-up (private, single-user installs).
ALLOW_SIGNUP=true
